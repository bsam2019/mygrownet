{
  "name": "GrowStream",
  "version": "1.0.0",
  "description": "Single source of truth for GrowStream design tokens. Web consumes via tailwind.growstream.config.js (rgb vars). iOS/Android should consume this file directly to avoid color drift.",
  "typography": {
    "fontFamily": {
      "display": "Plus Jakarta Sans",
      "body": "Be Vietnam Pro"
    },
    "fontSize": {
      "display-lg": { "size": 48, "lineHeight": 56, "letterSpacing": -0.02, "fontWeight": "800" },
      "headline-lg": { "size": 32, "lineHeight": 40, "fontWeight": "700" },
      "headline-lg-mobile": { "size": 24, "lineHeight": 32, "fontWeight": "700" },
      "headline-md": { "size": 24, "lineHeight": 32, "fontWeight": "600" },
      "body-lg": { "size": 18, "lineHeight": 28, "fontWeight": "400" },
      "body-md": { "size": 16, "lineHeight": 24, "fontWeight": "400" },
      "label-md": { "size": 14, "lineHeight": 20, "fontWeight": "600" },
      "label-sm": { "size": 12, "lineHeight": 16, "fontWeight": "500" }
    }
  },
  "radius": {
    "DEFAULT": 4,
    "lg": 8,
    "xl": 12,
    "full": 9999
  },
  "spacing": {
    "margin-mobile": 16,
    "margin-desktop": 32,
    "gutter": 16
  },
  "light": {
